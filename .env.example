# Required. Use at least 16 random characters.
API_KEY=replace-with-a-random-secret

# Host-port or port-only values are accepted (for example, :8080 or 8080).
LISTEN_ADDRESS=:8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=15s

# PNG fallback rendered in the center when show_logo=true without a custom logo.
FALLBACK_LOGO_PATH=assets/fallback-logo.png
LOGO_MAX_BYTES=1048576
OPENAPI_PATH=docs/openapi.yaml
